# Copy this file to .env (same folder as pom.xml) and put your real values in it.
# .env is in .gitignore, so your keys never go to GitHub. Environment variables work too.

# Brevo SMTP (Brevo -> SMTP & API -> SMTP tab)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your-smtp-login@smtp-brevo.com
MAIL_PASS=your-brevo-smtp-key
# A sender email you verified in Brevo (Senders, domains & dedicated IPs)
MAIL_FROM=your-verified-sender@gmail.com

# Gmail instead: MAIL_HOST=smtp.gmail.com, MAIL_USER=your@gmail.com, MAIL_PASS=16-letter App Password

# JWT signing key, 32 or more characters
JWT_SECRET=change-this-to-a-long-random-secret-key-123456
